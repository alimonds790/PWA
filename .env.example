# Postgres connection string (Neon / Vercel Postgres pooled URL works)
DATABASE_URL=postgres://user:pass@host/db

# 32+ random bytes; signs sessions, member tokens are random per-member
AUTH_SECRET=change-me-to-a-long-random-string

# DEMO ONLY — echoes the OTP back to the login screen instead of sending SMS.
# MUST be unset/0 in any real deployment (see COMPLIANCE.md §B6).
DEV_OTP_ECHO=1
